# Скопируйте в deploy/.env и задайте значения. .env в git не коммитится.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
# Необязательно: каталог сборки frontend (по умолчанию заглушка deploy/frontend-stub).
# FRONTEND_DIST=../../frontend/dist/frontend/browser
# SITE_ADDRESS=localhost
# Необязательно: путь к репозиторию core (по умолчанию ../../core от deploy/, т.е. сосед backend).
# CORE_DIR=../../core
