# Дополнительные переменные окружения для deploy/docker-compose.observability.yml.
# Добавьте нужные значения в deploy/.env (переменные имеют безопасные значения по умолчанию для локального запуска).

# Учётные данные Grafana (https://localhost/grafana/)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Basic Auth для VMUI, VLUI, vmalert, Alertmanager через Caddy HTTPS.
# Сгенерировать новый хеш: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'ваш-пароль'
# Внимание: в docker-compose.yml / .env символы $ нужно экранировать как $$ при передаче через compose,
# либо использовать single-quoted значение в .env.
OBS_BASIC_AUTH_USER=admin
OBS_BASIC_AUTH_HASH=$2a$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy

# Срок хранения метрик и логов
VM_RETENTION_PERIOD=30d
VL_RETENTION_PERIOD=14d
