          "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(caddy_http_request_duration_seconds_bucket{job=\"caddy\",handler=\"subroute\"}[5m])))",
          "legendFormat": "p99 (SLO < 1000ms)",
          "refId": "C"
