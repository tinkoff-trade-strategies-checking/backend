# Для локального запуска localhost получает сертификат внутреннего CA Caddy (tls internal).
{$SITE_ADDRESS:localhost} {
	tls internal
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv/frontend
		@immutable path *.js *.css *.woff2 /assets/* /media/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
